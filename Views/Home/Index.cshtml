@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row shadow rounded">
        <div class="col-sm-12 col-md-6 col-lg-6 col-xl-6">
            <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner h-100">
                    <div class="carousel-item h-100 active">
                        <img src="/images/carouselImages/shourav-sheikh-a66sGfOnnqQ-unsplash.jpg" class="d-block w-100 h-100" alt="Recipes">
                    </div>
                    <div class="carousel-item">
                        <img src="./images/carouselImages/pexels-chanwalrus-958545.jpg" class="d-block w-100 h-100" alt="Recipes">
                    </div>
                    <div class="carousel-item">
                        <img src="./images/carouselImages/pexels-marvin-ozz-1297854-2474661.jpg" class="d-block w-100 h-100" alt="Recipes">
                    </div>
                </div>
            </div>
        </div>
    
    <div class="col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <div class="mb-3">
                <h2>Get The Best <span class="text-success">Food</span> From
                    <span class="text-success">The Best Restaurants.</span> </h2>
        </div>
        <div class="mb-1 p-3">
                <span><i class="fa-solid fa-seedling text-success mx-2 fs-4"></i></span>
            <span class="fs-5 text-dark fst-italic">Freash Food</span>
        </div>
        <div class="mb-1 p-3">
                <span><i class="fa-solid fa-wheat-awn text-success mx-2 fs-4"></i></span>
                <span class="fs-5 text-dark fst-italic">Healthy Meal</span>
        </div>
        <div class="mb-1 p-3">
                <span><i class="fa-solid fa-person-biking text-success mx-2 fs-4"></i></span>
                <span class="fs-5 text-dark fst-italic">Fastest Delivery</span>
            <p class="py-2">We Promise Deliver Order within 30 Min</p>
        </div>
    </div>
</div>
<div class="row mt-3">
    <div class="col-12 mb-3">
        <h2 class="text-dark fst-italic">Today's Special</h2>
        <div id="todaySpecial" class="row">
                <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                    <div class="shadow rounded card dishCard">
                        <img class="card-img-top h-50" src="http://forkify-api.herokuapp.com/images/BBQChickenPizzawithCauliflowerCrust5004699695624ce.jpg" />
                        <div class="card-body">
                            <h5 class="card-title text-dark">Pizza</h5>
                            <div class="d-flex flex-wrap justify-content-between">
                                <a href="/Recipe/Order?id=664c8f193e7aa067e94e8610"
                                   class="btn btn-sm bg-black text-white shadow rounded p-2">Order</a>
                                <span class="addToCartIcon"><i class="fa-regular fa-heart fs-3"></i></span>
                            </div>
                            
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                    <div class="shadow rounded card dishCard">
                        <img class="card-img-top h-50" src="http://forkify-api.herokuapp.com/images/gelatin_poke_cake2d07.jpg" />
                        <div class="card-body">
                            <h5 class="card-title text-dark">Cake</h5>
                            <div class="d-flex flex-wrap justify-content-between">
                            <a href="/Recipe/Order?id=664c8f193e7aa067e94e893a"
                                   class="btn btn-sm bg-black text-white shadow rounded p-2">Order</a>
                                <span class="addToCartIcon"><i class="fa-regular fa-heart fs-3"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4 col-md-4 col-lg-4 col-xl-4">
                    <div class="shadow rounded card dishCard">
                        <img class="card-img-top h-50" src="https://forkify-api.herokuapp.com/images/RecipeImageff4f.jpg" />
                        <div class="card-body">
                            <h5 class="card-title text-dark">Blueberry</h5>
                            <div class="d-flex flex-wrap justify-content-between">
                            <a href="/Recipe/Order?id=664c8f193e7aa067e94e8af8"
                               class="btn btn-sm bg-black text-white shadow rounded p-2">Order</a>
                                <span class="addToCartIcon"><i class="fa-regular fa-heart fs-3"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>
</div>
